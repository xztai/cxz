{
	"name": "etheyl-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm check:assets",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate:api": "pnpm --dir tools/openapi run generate",
		"test:e2e": "playwright test",
		"test:e2e:publications": "playwright test --config playwright.publications.config.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:mcp": "node scripts/check-mcp.mjs",
		"test:unit": "node --test tests/unit/*.test.ts",
		"check:assets": "node scripts/check-assets.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.71.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/mcp": "0.1.30",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"bits-ui": "2.21.0",
		"cn": "0.5.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"shadcn-svelte": "1.8.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "4.0.2",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.7"
	},
	"dependencies": {
		"@fontsource-variable/golos-text": "^5.3.0",
		"openapi-fetch": "0.17.0"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26.13.0 <27",
		"pnpm": "12.18.0"
	}
}
