APP_ORIGIN=http://localhost:8080
APP_PORT=8080
COOKIE_SECURE=false
POSTGRES_PASSWORD=replace-with-random-hex
MINIO_ROOT_USER=etheyl
MINIO_ROOT_PASSWORD=replace-with-random-hex
MAILPIT_PORT=8025
MIGRATE_DATABASE_PASSWORD=replace-with-random-hex
API_DATABASE_PASSWORD=replace-with-random-hex
WORKER_DATABASE_PASSWORD=replace-with-random-hex
# Comma-separated base64 AES-256 keys, active key first. Generate with make init.
OUTBOX_KEYS=replace-with-base64-32-byte-key

# Compose keeps this bucket private and serves profile images through the API.
S3_BUCKET=etheyl-media
# For Go outside Compose: S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_SECURE.

# Test shop only; leave BOTH empty to run without payments.
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=
