      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border:1px solid transparent;border-radius:var(--control-radius,8px);font-family:var(--font-body,'Golos Text',sans-serif);font-size:14px;font-weight:500;line-height:20px;text-decoration:none;white-space:nowrap;cursor:pointer;transition:background-color 200ms,color 200ms,border-color 200ms;background:var(--primary,#2448e5);color:var(--primary-foreground,#ffffff);}.ds-btn-primary:hover{background:var(--foreground,#20251f);}.ds-btn-primary:focus-visible{border-color:var(--ring,#2448e5);outline:none;box-shadow:0 0 0 1px var(--ring,#2448e5);}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:disabled{opacity:.5;pointer-events:none}"
