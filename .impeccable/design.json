      "css": ".ds-auth-nav{display:flex;gap:28px;border-bottom:1px solid var(--border,#d5d9ce);font-family:var(--font-body,'Golos Text',sans-serif)}.ds-auth-nav a{padding-bottom:12px;color:var(--muted-foreground,#62665e);font-size:14px;line-height:1.6;text-decoration:none}.ds-auth-nav a[aria-current]{border-bottom:2px solid var(--blue,#2448e5);color:var(--blue,#2448e5);margin-bottom:-1px}.ds-auth-nav a:focus-visible{outline:2px solid currentColor;outline-offset:5px}"
