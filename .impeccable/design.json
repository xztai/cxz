      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-email\">Email</label><input class=\"ds-field-input\" id=\"ds-email\" type=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\"/><p class=\"ds-field-help\">Почта для доступа к аккаунту.</p></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;max-width:360px;font-family:var(--font-body,'Golos Text',sans-serif);color:var(--ink,#20251f)}.ds-field-label{font-size:13px;font-weight:500;line-height:1.375}.ds-field-input{height:48px;width:100%;min-width:0;padding:12px 14px;border:1px solid var(--input,#bec5b6);border-radius:8px;background:var(--card,#ffffff);color:var(--ink,#20251f);font-family:inherit;font-size:16px;caret-color:var(--blue,#2448e5);transition:color 150ms,border-color 150ms}.ds-field-input::placeholder{color:var(--muted-foreground,#62665e)}.ds-field-input:focus-visible{outline:none;border-color:var(--ring,#2448e5);box-shadow:0 0 0 1px color-mix(in oklab,var(--ring,#2448e5) 50%,transparent)}.ds-field-input[aria-invalid=true]{border-color:var(--destructive,#b02d28);box-shadow:0 0 0 1px color-mix(in oklab,var(--destructive,#b02d28) 20%,transparent)}.ds-field-input:disabled{opacity:.5;pointer-events:none}.ds-field-help{margin:0;font-size:11px;line-height:1.6;color:var(--muted-foreground,#62665e)}"
