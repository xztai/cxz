  "narrative": {
    "northStar": "The Independent Cultural Journal",
    "overview": "etheyl speaks through the visual language of an independent cultural journal: expansive cobalt fields, pale yellow emphasis, generous paper margins, and confident Cyrillic headlines. Unbounded gives ideas a distinct public voice; Golos Text keeps explanations, navigation, and account tasks direct and readable. The eight-ray mark and fine orbital drawings connect the identity across surfaces.\n\nEditorial compositions can be expressive and layered. Account tasks become quieter: a white form, visible labels, and a single cobalt submit action. Both expressions belong to the same world through their typography, palette, and carefully controlled geometry. Russian remains the interface language, and etheyl remains the brand name.",
    "keyCharacteristics": [
      "Broad cobalt and paper regions with pale yellow emphasis.",
      "Unbounded headlines paired with practical Golos Text.",
      "Flat functional surfaces and selectively layered printed material.",
      "Fine geometric marks, soft control corners, and square journal pieces.",
      "Responsive simplification that gives account tasks the available space."
    ],
    "rules": [
      {
        "name": "The Cobalt and Lemon Rule",
        "body": "Use cobalt as an expressive field or a functional action; use Pale Lemon to hold emphasis against that field. On a white account surface, the principal action is cobalt.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Unbounded for the brand and editorial headings; use Golos Text for controls, field labels, explanatory copy, and navigation.",
        "section": "typography"
